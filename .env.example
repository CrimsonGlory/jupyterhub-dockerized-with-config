# Copy to .env and adjust. Values must match the hostname and paths in nginx.conf
# (copy from nginx/nginx.conf.example-with-ssl and replace course.example.com everywhere).

# Hostname served by nginx / requested certificate
CERTBOT_DOMAIN=course.example.com

# Optional. If set, used as the Let's Encrypt account email. If empty, certbot uses
# --register-unsafely-without-email (no expiry notices from Let's Encrypt).
CERTBOT_EMAIL=
